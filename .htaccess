# Block direct access to PHP includes and stored leads.
RedirectMatch 404 ^/(includes|storage)(/|$)

# Media types some hosts do not know yet (video captions, web fonts).
<IfModule mod_mime.c>
  AddType text/vtt .vtt
  AddType font/woff2 .woff2
</IfModule>

# Compress text responses (HTML, CSS, JS, SVG, captions). Brotli where the
# host has it, gzip otherwise.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/vtt application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/vtt application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets (URLs carry a ?v= version stamp).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/vtt "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
